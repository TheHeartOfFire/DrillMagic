<UserControl
    x:Class="DrillMagic.Windows.Controls.ColorSummaryLegend"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DrillMagic.Windows.Controls"
    xmlns:models="using:DrillMagic.Windows.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:DrillMagic.Windows.Converters"
    mc:Ignorable="d">
    
    <UserControl.Resources>
        <converters:ColorToForegroundConverter x:Key="ColorToForegroundConverter"/>
    </UserControl.Resources>

    <Grid Background="{ThemeResource SystemControlAcrylicWindowBrush}" CornerRadius="8" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Totals -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Padding="16,8,0,8" >
            <TextBlock FontWeight="SemiBold">
                <Run Text="Total Colors:"/>
                <Run Text="{x:Bind ColorSummary.Count, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock FontWeight="SemiBold">
                <Run Text="Total Drills:"/>
                <Run Text="{x:Bind TotalDrills, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <!-- Fixed Header -->
        <Grid Grid.Row="1" Padding="16,8,0,8" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Color" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Info" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Grid>

        <!-- Scrollable List -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ColorSummary, Mode=OneWay}" IsItemClickEnabled="False" SelectionMode="None" Padding="0,0,0,8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ColorSummaryItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Combined Color and Symbol -->
                        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="24" Height="24" RadiusX="4" RadiusY="4">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{x:Bind Color}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Text="{x:Bind Symbol}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold"
                                       Foreground="{x:Bind Color, Converter={StaticResource ColorToForegroundConverter}}"/>
                        </Grid>

                        <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind DMCNumber}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>