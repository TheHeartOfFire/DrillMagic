<UserControl
    x:Class="DrillMagic.Windows.Controls.ColorSummaryLegend"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DrillMagic.Windows.Controls"
    xmlns:models="using:DrillMagic.Windows.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource SystemControlAcrylicWindowBrush}" CornerRadius="8" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fixed Header -->
        <Grid Grid.Row="0" Padding="16,8,0,8" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Color" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Info" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Symbol" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Grid>

        <!-- Scrollable List -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind ColorSummary, Mode=OneWay}" IsItemClickEnabled="False" SelectionMode="None" Padding="0,0,0,8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ColorSummaryItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Width="16" Height="16" RadiusX="4" RadiusY="4">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{x:Bind Color}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Bind DMCNumber}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{x:Bind Symbol}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>