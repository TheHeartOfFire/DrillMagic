<ContentDialog
    x:Class="DrillMagic.Windows.Controls.ImageDoctorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="Image Preparation &amp; Doctoring"
    PrimaryButtonText="Apply &amp; Generate Grid"
    SecondaryButtonText="Skip Edits"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ImageDoctorDialog_PrimaryButtonClick"
    MinWidth="600"
    MinHeight="450"
    MaxWidth="5000"
    MaxHeight="3000">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">700</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">5000</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">500</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">3000</x:Double>
        <x:Double x:Key="ContentDialogContentMaxHeight">3000</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="RootContainer" MinWidth="750" MinHeight="500" KeyDown="RootContainer_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== DOCTOR TOOLBAR ==================== -->
        <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tool Mode Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <AppBarToggleButton x:Name="ToolPanBtn" Icon="TouchPointer" Label="Pan/Zoom" Click="ToolButton_Click" IsChecked="True" ToolTipService.ToolTip="Pan and view image"/>
                    <AppBarToggleButton x:Name="ToolCropBtn" Icon="Crop" Label="Crop" Click="ToolButton_Click" ToolTipService.ToolTip="Select crop rectangle"/>
                    <AppBarToggleButton x:Name="ToolBrushBtn" Icon="Highlight" Label="Brush" Click="ToolButton_Click" ToolTipService.ToolTip="Paint/touch-up pixels"/>
                    <AppBarToggleButton x:Name="ToolLineBtn" Icon="Edit" Label="Line" Click="ToolButton_Click" ToolTipService.ToolTip="Draw straight lines"/>
                    <AppBarToggleButton x:Name="ToolRectBtn" Icon="Stop" Label="Rectangle" Click="ToolButton_Click" ToolTipService.ToolTip="Draw rectangle"/>
                    <AppBarToggleButton x:Name="ToolEllipseBtn" Label="Ellipse" Click="ToolButton_Click" ToolTipService.ToolTip="Draw ellipse/circle">
                        <AppBarToggleButton.Icon>
                            <FontIcon Glyph="&#xEA38;"/>
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarToggleButton x:Name="ToolEyedropperBtn" Icon="FontColor" Label="Eyedropper" Click="ToolButton_Click" ToolTipService.ToolTip="Sample color from image"/>

                    <AppBarSeparator/>

                    <!-- Crop Action Buttons (visible when Crop is active) -->
                    <Button x:Name="ApplyCropBtn" Content="Apply Crop" Style="{ThemeResource AccentButtonStyle}" Click="ApplyCropBtn_Click" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,0"/>
                    <Button x:Name="ResetCropBtn" Content="Cancel Box" Click="ResetCropBtn_Click" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,0"/>
                </StackPanel>

                <!-- Tool Options (Color, Brush Size, Filled Shape) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0">
                    <!-- Shape Fill Checkbox -->
                    <CheckBox x:Name="FillShapeCheckBox" Content="Fill Shape" IsChecked="True" VerticalAlignment="Center" Visibility="Collapsed"/>

                    <!-- Brush Size Slider -->
                    <StackPanel x:Name="BrushSizePanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Size:" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                        <Slider x:Name="BrushSizeSlider" Value="4" Minimum="1" Maximum="40" StepFrequency="1" Width="100" VerticalAlignment="Center" ValueChanged="BrushSizeSlider_ValueChanged"/>
                        <TextBlock x:Name="BrushSizeText" Text="4 px" FontSize="12" Width="36" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Active Painting Color Swatch & Flyout -->
                    <Button x:Name="DoctorColorSwatchBtn" Click="DoctorColorSwatchBtn_Click" Padding="4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Select drawing color">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border x:Name="ColorPreviewBorder" Width="26" Height="26" CornerRadius="4" Background="Black" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"/>
                            <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="ColorPickerFlyout" Placement="Bottom">
                                <Border Padding="8">
                                    <StackPanel Spacing="8">
                                        <ct:ColorPicker x:Name="DoctorColorPicker" IsColorPaletteVisible="True" IsColorSpectrumVisible="True" ColorChanged="DoctorColorPicker_ColorChanged"/>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- History & View Actions (Fit, 100%, Undo, Reset All) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <AppBarButton x:Name="FitViewBtn" Icon="FullScreen" Label="Fit" Click="FitViewBtn_Click" ToolTipService.ToolTip="Fit image to window"/>
                    <AppBarButton x:Name="ActualSizeBtn" Icon="Zoom" Label="100%" Click="ActualSizeBtn_Click" ToolTipService.ToolTip="View image at 100% scale"/>
                    <AppBarSeparator/>
                    <AppBarButton x:Name="HistoryBtn" Icon="Clock" Label="History" Visibility="Collapsed" ToolTipService.ToolTip="Switch to a past base image version">
                        <AppBarButton.Flyout>
                            <MenuFlyout x:Name="HistoryMenuFlyout"/>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton x:Name="UndoBtn" Icon="Undo" Label="Undo" Click="UndoBtn_Click" IsEnabled="False" ToolTipService.ToolTip="Undo last edit"/>
                    <AppBarButton x:Name="RevertBtn" Icon="Refresh" Label="Revert All" Click="RevertBtn_Click" ToolTipService.ToolTip="Revert to original loaded image"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== VIEWPORT CANVAS ==================== -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <canvas:CanvasControl x:Name="DoctorCanvas"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Draw="DoctorCanvas_Draw"
                                  SizeChanged="DoctorCanvas_SizeChanged"
                                  PointerPressed="DoctorCanvas_PointerPressed"
                                  PointerMoved="DoctorCanvas_PointerMoved"
                                  PointerReleased="DoctorCanvas_PointerReleased"
                                  PointerWheelChanged="DoctorCanvas_PointerWheelChanged"
                                  DoubleTapped="DoctorCanvas_DoubleTapped"/>
        </Border>

        <!-- ==================== BOTTOM STATUS READOUT ==================== -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12,6" Margin="0,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="ImageDimensionsText" Text="Image: 0 × 0 px" FontSize="12" Opacity="0.85"/>
                    <TextBlock x:Name="CropInfoText" Text="" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Projected (10px cells):" FontSize="12" Opacity="0.6"/>
                    <TextBlock x:Name="ProjectedScaleText" Text="0 × 0 Drills" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
