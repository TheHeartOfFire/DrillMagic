<winex:WindowEx
    x:Class="DrillMagic.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:DrillMagic.Windows"
    xmlns:controls="using:DrillMagic.Windows.Controls"
    xmlns:core="using:DrillMagic.Core.Types"
    xmlns:winex="using:WinUIEx"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <media:MicaBackdrop/>
    </winex:WindowEx.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            OverflowButtonVisibility="Collapsed" 
            IsDynamicOverflowEnabled="False"
            IsOpen="True"
            IsSticky="True"
                    Background="#22000000">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <AppBarButton Icon="OpenFile" Label="Open" Click="OpenFile_Click"/>
                    <AppBarButton Icon="Print" Label="Print" Click="PrintButton_Click" x:Name="PrintButton"/>
                    <AppBarSeparator/>
                    <AppBarToggleButton x:Name="PointerButton" Icon="TouchPointer" Label="Navigate" Click="PointerButton_Click" IsChecked="true"/>
                    <AppBarToggleButton x:Name="PaintBucketButton" Icon="Highlight" Label="Coloring" Click="PaintBucketButton_Click"/>
                    <AppBarToggleButton x:Name="ColorInspectorButton" Icon="FontColor" Label="Inspect" Click="ColorInspectorButton_Click"/>
                    <AppBarToggleButton x:Name="SymbolOverlayButton" Icon="Character" Label="Symbols" Click="SymbolOverlayButton_Click" IsChecked="true"/>
                    <AppBarButton Icon="Filter" Label="Reduce Colors" Click="ReduceColors_Click"/>
                    <AppBarButton x:Name="ClearHighlightButton" Icon="Clear" Label="Clear Highlight" Click="ClearHighlight_Click" Visibility="Collapsed"/>
                    <AppBarSeparator/>

                    <StackPanel x:Name="CellSizePanel" Orientation="Vertical" Margin="8,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind FormatCellSize(CellSizeSlider.Value), Mode=OneWay}" FontSize="12" Margin="0,0,0,2"/>
                        <Slider x:Name="CellSizeSlider" Value="10" Width="100" Minimum="1" Maximum="20" StepFrequency="1" ValueChanged="CellSizeSlider_ValueChanged"/>
                    </StackPanel>
                    <AppBarSeparator x:Name="CellSizeSeparator" Visibility="Collapsed"/>
                    <AppBarButton x:Name="ToolkitPickerButton" Click="ToolkitPickerButton_Click" 
                                  HorizontalAlignment="Left" Label="{x:Bind SelectedColorName, Mode=OneWay}"
                                  Icon="FontColor" Background="{x:Bind SelectedBrush, Mode=OneWay}">

                        <AppBarButton.Flyout>
                            <Flyout x:Name="ToolkitColorFlyout" Placement="Bottom">
                                <Border Padding="8" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                    <StackPanel>
                                        <TextBox x:Name="ToolkitSearchBox" PlaceholderText="Filter palette (optional)" TextChanged="ToolkitSearchBox_TextChanged" Margin="0,0,0,8"/>
                                        <ct:ColorPicker x:Name="ToolkitColorPicker"
                                    IsColorPaletteVisible="True"
                                    IsColorSpectrumVisible="true"
                                    CustomPaletteColumnCount="12"
                                    ColorChanged="ToolkitColorPicker_ColorChanged"/>
                                        
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <controls:DrillGridView Grid.Row="1" x:Name="MyDrillGridView" Grid="{x:Bind DrillGridManager.SelectedGrid, Mode=OneWay}" />
    </Grid>
</winex:WindowEx>